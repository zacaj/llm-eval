#!/bin/bash
# (tb2_tc) Runs as root via sudo from /usr/local/bin/run-tests (no arguments, nothing
# read from the agent). Unlike polyglot-tc, TB2 tests check the live system at absolute
# /app paths and some rewrite files there (cobol-modernization resets its .DAT files
# and runs /app/program.py), so they can't run on a scratch copy: /app is snapshotted,
# the tests run in place exactly as final grading runs them, and /app is restored.
# Log format matches polyglot-tc's run-tests-inner (collect.py reads both):
# n, end timestamp, exit code, passed, total, start timestamp.
set -uo pipefail
export LC_ALL=C   # comm below needs ls sorted the same way
trap '' PIPE

LIMIT=$(cat /opt/run-tests/limit)
STATE=/var/lib/run-tests
LOG=$STATE/log.tsv
n=$(( $(wc -l 2>/dev/null < "$LOG" || echo 0) + 1 ))
if [ "$n" -gt "$LIMIT" ]; then
    echo "No test runs left (all $LIMIT used)."
    exit 3
fi

started=$(date -u +%FT%T.%3NZ)
OUT=$(mktemp -d /tmp/run-tests-out.XXXXXX)
SNAP=$(mktemp /tmp/run-tests-snap.XXXXXX.tar)
trap 'rm -rf "$OUT" "$SNAP"' EXIT
tar -C /app -cpf "$SNAP" .
# some tests also leave state outside /app (headless-terminal: mkdir /server + a root
# http.server on :8000), which made every later run fail. The agent is non-root, so
# new top-level paths and new root processes after a run are the tests' leftovers.
ROOTS_BEFORE=$(ls -A /)
PIDS_BEFORE=" $(pgrep -u root | tr '\n' ' ')"

SAVED=$STATE/run-$n.txt
exec > >(tee -p "$SAVED") 2>&1
echo "Test run $n of $LIMIT... (this output is also saved to $SAVED)"
OUT="$OUT" TEST_DIR=/opt/hidden-tests bash /opt/hidden-tests/test.sh > "$OUT/full.log" 2>&1

# put the agent's /app back as it was (the tests may have rewritten files in it)
find /app -mindepth 1 -delete 2>/dev/null
tar -C /app -xpf "$SNAP"
for p in $(pgrep -u root); do   # skip our own tee (child of $$) and pre-existing ones
    [ "$p" = $$ ] || [[ "$PIDS_BEFORE" == *" $p "* ]] || [ "$(ps -o ppid= -p "$p" | tr -d ' ')" = $$ ] \
        || kill -9 "$p" 2>/dev/null
done
comm -13 <(echo "$ROOTS_BEFORE") <(ls -A /) | while read -r e; do rm -rf "/${e:?}"; done

j=$(cat "$OUT/reward.json" 2>/dev/null || true)
field() { printf '%s' "$j" | grep -o "\"$1\": *[0-9]*" | grep -o '[0-9]*$' || echo 0; }
passed=$(field tests_passed); total=$(field tests_total)
rc=$([ "$(field reward)" = 1 ] && echo 0 || echo 1)
printf '%d\t%s\t%d\t%d\t%d\t%s\n' "$n" "$(date -u +%FT%T.%3NZ)" "$rc" "$passed" "$total" "$started" >> "$LOG"
[ "$n" -ge "$LIMIT" ] && touch "$STATE/limit_reached"

out="$OUT/test-output.txt"
lines=$(wc -l < "$out" 2>/dev/null || echo 0)
if [ ! -s "$out" ]; then
    echo "[test harness failed before running the tests; last lines of its log:]"
    tail -40 "$OUT/full.log" 2>/dev/null
elif [ "$lines" -gt 250 ]; then
    head -50 "$out"; echo "... [$((lines - 200)) lines omitted] ..."; tail -150 "$out"
else
    cat "$out" 2>/dev/null
fi
echo
if [ "$rc" -eq 0 ]; then
    echo "Test run $n of $LIMIT: all $total tests passed."
elif [ "$total" -eq 0 ]; then
    echo "Test run $n of $LIMIT: FAILED (the tests did not run -- see errors above). Runs left: $((LIMIT - n))."
else
    echo "Test run $n of $LIMIT: FAILED ($passed of $total tests passed). Runs left: $((LIMIT - n))."
fi
exec >&- 2>&-; wait
chmod 644 "$SAVED" 2>/dev/null
exit "$rc"
